{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "index.py"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "DECISION_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/analogs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/score",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/stress-test",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
